NEXT_PUBLIC_SITE_URL=https://sarkarimatch.com

# Render Postgres External Database URL for local work, or pglite://./.data/dev for a zero-setup local database.
DATABASE_URL=
# At least 32 random characters (openssl rand -base64 48).
AUTH_SECRET=

# Payments: you host the payment page. TEST_CHECKOUT_URL receives ?product=pass|guide&series=<slug>|exam=<slug>&amount=<paise>&ref=<signed token>.
# After payment, your server calls POST /api/internal/grant-access with `Authorization: Bearer ACCESS_GRANT_SECRET`
# and JSON { "paymentRef": "...", "ref": "<the token>", "amountPaise": <paid> }. See docs/offering.md.
TEST_CHECKOUT_URL=
ACCESS_GRANT_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_ANNUAL=
RAZORPAY_PLAN_PRO_PLUS_MONTHLY=
RAZORPAY_PLAN_PRO_PLUS_ANNUAL=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=

NEXT_PUBLIC_ENABLE_PAYMENTS=false
NEXT_PUBLIC_ENABLE_PRO_PLUS=false
NEXT_PUBLIC_ENABLE_WHATSAPP=false
NEXT_PUBLIC_ENABLE_ADS=false
NEXT_PUBLIC_ENABLE_EMAIL_ALERTS=false

CRON_SECRET=

# Floating WhatsApp button: digits only with country code, for example 919876543210. Hidden when empty.
NEXT_PUBLIC_WHATSAPP_NUMBER=
# AI assistant (24/7 learner support). Hidden when no key is set. ASSISTANT_MODEL defaults to claude-haiku-5-5.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=
ASSISTANT_DAILY_LIMIT=3000

# AI Study Guide (paid add-on). Uses ANTHROPIC_API_KEY. Defaults shown. AI_PROVIDER=mock gives canned replies in development.
AI_PROVIDER=
GUIDE_MODEL_FAST=claude-haiku-5-5
GUIDE_MODEL_DEEP=claude-sonnet-5-5
